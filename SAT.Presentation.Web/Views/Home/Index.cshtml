@{
    ViewData["Title"] = "Home Page";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="text-center">
    <table class="table table-primary table-striped table-sm">
        <thead>
            <tr>
                <th>NOMBRE</th>
                <th>FECHA DE NACIMIENTO</th>
                <th>RFC</th>
                <th><button class="btn btn-secondary btnCrear">CREAR</button></th>
            </tr>
        </thead>
        <tbody id="tableBody">
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_modalContribuyente")

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let listUsers = {};
        document.addEventListener('DOMContentLoaded', async function(){
            let url = '';
            let messageSuccess = {};

            await fetchData();
            console.log('listUsers', listUsers);
            document.querySelector('.btnCrear').addEventListener('click', function(){
                document.querySelector('.modal-title').textContent = 'Crear Contribuyente';
                document.getElementById('IdUser').value = '';
                document.getElementById('Nombre').value = '';
                document.getElementById('ApellidoPaterno').value = '';
                document.getElementById('ApellidoMaterno').value = '';
                document.getElementById('FechaNacimiento').value = '';
                document.getElementById('btnAdd').textContent = 'Crear';
                show_modal();
                url = '/crear-rfc';
                messageSuccess = {
                    title: "¡Contribuyenete Creado!",
                    text: "El Contribuyenete se creo con éxito."
                };
            });

            //cuando se presione un elemento de la tabla
            document.getElementById('tableBody').addEventListener('click', function(event){
                if(event.target.classList.contains('btnEditar')){
                    const id = event.target.getAttribute('data-id');
                    //obtener nombre y apellido
                    const user = listUsers.find(user => user.idUser == id);
                    console.log(user);
                    document.querySelector('.modal-title').textContent = 'Editar Contribuyente';
                    document.getElementById('IdUser').value = user.idUser;
                    document.getElementById('Nombre').value = user.nombre;
                    document.getElementById('ApellidoPaterno').value = user.apellidoPaterno;
                    document.getElementById('ApellidoMaterno').value = user.apellidoMaterno;
                    document.getElementById('FechaNacimiento').value = user.fechaNacimiento.split("T")[0];
                    document.getElementById('btnAdd').textContent = 'Editar';
                    show_modal();
                    url = `/editar-rfc/`;
                    messageSuccess = {
                        title: "¡Contribuyenete Editado!",
                        text: "El Contribuyenete se edito con éxito."
                    };

                }
                if(event.target.classList.contains('btnEliminar')){
                    const id = event.target.getAttribute('data-id');
                    Swal.fire({
                        title: '¿Estás seguro?',
                        text: "¡No podrás revertir esto!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sí, eliminarlo!'
                    }).then(async (result) => {
                        if (result.isConfirmed) {
                            try{
                                const response = await fetch(`/eliminar-rfc/`, {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify(id),
                                })
                                const data = await response.json();
                                if(data.Exito != false){
                                    await fetchData();
                                    Swal.fire(
                                        '¡Eliminado!',
                                        'El Contribuyenete ha sido eliminado.',
                                        'success'
                                    )
                                } else {
                                    Swal.fire({
                                        title: "¡Error!",
                                        text: data.Mensaje,
                                        icon: "error",
                                        confirmButtonText: "Aceptar"
                                    });
                                }
                            }
                            catch(error){
                                console.error('Error deleting record:', error);
                            }
                        }
                    });
                }
            });

            document.getElementById('formContacto').addEventListener('submit', async function(event){
                event.preventDefault();
                const formData = new FormData(this);
                await addOrCreate(formData, url, messageSuccess);
            });
        });
        function show_modal(){
            const modal = new bootstrap.Modal(document.getElementById('miModalAdd'));
            modal.show();
        }
        function hide_modal(){
            const modal = bootstrap.Modal.getInstance(document.getElementById('miModalAdd'));
            modal.hide();
        }
        async function addOrCreate(formData, url, messageSuccess){
            for (const [key, value] of formData.entries()) {
                console.log(key, value);
            }
            if(formData.get('Nombre') && formData.get('ApellidoPaterno') && formData.get('FechaNacimiento')){
                try{
                    const response = await fetch(url, {
                        method: 'POST',
                        body: formData
                    })
                    const data = await response.json();
                    if(data.Exito != false){
                        await fetchData();
                        hide_modal();
                        Swal.fire({
                            title: messageSuccess.title,
                            text: messageSuccess.text,
                            icon: "success",
                            confirmButtonText: "Aceptar"
                        });
                    } else {
                        Swal.fire({
                            title: "¡Error!",
                            text: data.Mensaje,
                            icon: "error",
                            confirmButtonText: "Aceptar"
                        });
                    }
                }
                catch(error){
                    console.error('Error creating record:', error);
                }
            } else {
                alert("Todos los campos son obligatorios.");
            }
        }
        async function fetchData() {
            try{
                mostrarLoading();
                const response = await fetch('/obtener-rfcs')
                const data = await response.json();
                if(data.Exito != false){
                    const tableBody = document.getElementById('tableBody');
                    tableBody.innerHTML = '';
                    listUsers = data.item;
                    data.item.forEach(persona => {
                        const row = document.createElement('tr');
                        row.innerHTML = `
                            <td>${persona.nombre} ${persona.apellidoPaterno} ${persona.apellidoMaterno}</td>
                            <td>${persona.viewFechaNacimiento}</td>
                            <td>${persona.rfc}</td>
                            <td><button class="btn btn-primary btnEditar" data-id="${persona.idUser}">EDITAR</button>
                            <button class="btn btn-danger btnEliminar" data-id="${persona.idUser}">DELETE</button></td>
                        `;
                        tableBody.appendChild(row);
                    });
                } else {
                    alert(data.Mensaje);
                }
            }
            catch(error){
                console.error('Error fetching data:', error);
            }
            finally{
                ocultarLoading();            
            }
        }
    </script>
}