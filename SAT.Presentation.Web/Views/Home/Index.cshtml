@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    @* <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p> *@
    <table class="table table-primary table-striped table-sm">
        <thead>
            <tr>
                <th>NOMBRE</th>
                <th>FECHA DE NACIMIENTO</th>
                <th>RFC</th>
                <th><button class="btn btn-secondary btnCrear">CREAR</button></th>
            </tr>
        </thead>
        <tbody id="tableBody">
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            fetchData();

            document.querySelector('.btnCrear').addEventListener('click', function(){
                //abrir modal
            });
        });
        function addOrCreate(){
            const nombre = prompt("Ingrese el nombre:");
            const apellidoPaterno = prompt("Ingrese el apellido paterno:");
            const apellidoMaterno = prompt("Ingrese el apellido materno:");
            const fechaNacimiento = prompt("Ingrese la fecha de nacimiento (YYYY-MM-DD):");
            const rfc = prompt("Ingrese el RFC:");
            if(nombre && apellidoPaterno && apellidoMaterno && fechaNacimiento && rfc){
                fetch('/crear-rfc', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        nombre: nombre,
                        apellidoPaterno: apellidoPaterno,
                        apellidoMaterno: apellidoMaterno,
                        fechaNacimiento: fechaNacimiento,
                        rfc: rfc
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if(data.Exito != false){
                        alert('Registro creado exitosamente');
                        fetchData(); // Refresh the table
                    } else {
                        alert(data.Mensaje);
                    }
                })
                .catch(error => console.error('Error creating record:', error));
            } else {
                alert("Todos los campos son obligatorios.");
            }
        }
        function fetchData() {
            fetch('/obtener-rfcs')
                .then(response => response.json())
                .then(data => {
                    if(data.Exito != false){
                        const tableBody = document.getElementById('tableBody');
                        tableBody.innerHTML = ''; // Clear existing rows
                        data.item.forEach(persona => {
                            const row = document.createElement('tr');
                            row.innerHTML = `
                                <td>${persona.nombre} ${persona.apellidoPaterno} ${persona.apellidoMaterno}</td>
                                <td>${persona.viewFechaNacimiento}</td>
                                <td>${persona.rfc}</td>
                                <td><button class="btn btn-primary btnEditar" data-id="${persona.idUser}">EDITAR</button>
                                <button class="btn btn-danger btnEliminar" data-id="${persona.idUser}">BORRAR</button></td>
                            `;
                            tableBody.appendChild(row);
                        });
                    } else {
                        alert(data.Mensaje);
                    }
                })
                .catch(error => console.error('Error fetching data:', error));
        }
    </script>
}