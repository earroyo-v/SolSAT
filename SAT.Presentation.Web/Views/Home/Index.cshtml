@{
    ViewData["Title"] = "Home Page";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="text-center">
    @* <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p> *@
    <table class="table table-primary table-striped table-sm">
        <thead>
            <tr>
                <th>NOMBRE</th>
                <th>FECHA DE NACIMIENTO</th>
                <th>RFC</th>
                <th><button class="btn btn-secondary btnCrear">CREAR</button></th>
            </tr>
        </thead>
        <tbody id="tableBody">
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_modalContribuyente")

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            let url = '';
            let messageSuccess = {};

            fetchData();

            document.querySelector('.btnCrear').addEventListener('click', function(){
                show_modal();
                url = '/crear-rfc';
                messageSuccess = {
                    title: "¡Contribuyenete Creado!",
                    text: "El Contribuyenete se creo con éxito."
                };
            });

            document.getElementById('formContacto').addEventListener('submit', function(event){
                event.preventDefault();
                const formData = new FormData(this);
                addOrCreate(formData, url, messageSuccess);
                
            });
        });
        function show_modal(){
            const modal = new bootstrap.Modal(document.getElementById('miModalAdd'));
            modal.show();
        }
        function hide_modal(){
            const modal = bootstrap.Modal.getInstance(document.getElementById('miModalAdd'));
            modal.hide();
        }
        function addOrCreate(formData, url, messageSuccess){
            for (const [key, value] of formData.entries()) {
                console.log(key, value);
            }
            if(formData.get('Nombre') && formData.get('ApellidoPaterno') && formData.get('FechaNacimiento')){                
                fetch(url, {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if(data.Exito != false){
                        fetchData();
                        hide_modal();
                        Swal.fire({
                            title: messageSuccess.title,
                            text: messageSuccess.text,
                            icon: "success",
                            confirmButtonText: "Aceptar"
                        });
                    } else {
                        Swal.fire({
                            title: "¡Error!",
                            text: data.Mensaje,
                            icon: "error",
                            confirmButtonText: "Aceptar"
                        });
                    }
                })
                .catch(error => console.error('Error creating record:', error));
            } else {
                alert("Todos los campos son obligatorios.");
            }
        }
        function fetchData() {
            fetch('/obtener-rfcs')
                .then(response => response.json())
                .then(data => {
                    if(data.Exito != false){
                        const tableBody = document.getElementById('tableBody');
                        tableBody.innerHTML = '';
                        data.item.forEach(persona => {
                            const row = document.createElement('tr');
                            row.innerHTML = `
                                <td>${persona.nombre} ${persona.apellidoPaterno} ${persona.apellidoMaterno}</td>
                                <td>${persona.viewFechaNacimiento}</td>
                                <td>${persona.rfc}</td>
                                <td><button class="btn btn-primary btnEditar" data-id="${persona.idUser}">EDITAR</button>
                                <button class="btn btn-danger btnEliminar" data-id="${persona.idUser}">DELETE</button></td>
                            `;
                            tableBody.appendChild(row);
                        });
                    } else {
                        alert(data.Mensaje);
                    }
                })
                .catch(error => console.error('Error fetching data:', error));
        }
    </script>
}